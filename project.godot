; BRASSLINE multiplayer prototype. Godot 4.7.2 Standard.
config_version=5

[application]
config/name="Brassline Offline Arenas"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Four arenas: training, endless bot practice and self-hosted internet 5v5."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.58, 0.73, 0.78, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=24.0

[audio]
driver/enable_input=false
